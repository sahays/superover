# Service Naming (namespaces Cloud Run services and Firestore collections)
SERVICE_NAME=superover

# GCP Configuration
GCP_PROJECT_ID=your-project-id
GCP_REGION=asia-south1

# GCS Buckets
UPLOADS_BUCKET=your-uploads-bucket
PROCESSED_BUCKET=your-processed-bucket
RESULTS_BUCKET=your-results-bucket

# Gemini API (uses ADC on Cloud Run — no API key needed)
GEMINI_REGION=global
GEMINI_DEFAULT_MODEL=models/gemini-3.1-pro-preview
GEMINI_DEFAULT_OUTPUT_TOKENS=65536
GEMINI_TEMPERATURE=1.0
GEMINI_IMAGE_MODEL=models/gemini-3-pro-image-preview
GEMINI_IMAGE_OUTPUT_TOKENS=32768

# Firestore
FIRESTORE_DATABASE=(default)

# Environment (local, development, production)
ENVIRONMENT=local

# Transcoder API (must match GCS bucket region)
TRANSCODER_LOCATION=asia-south1
TRANSCODER_JOB_TIMEOUT_SECONDS=600

# Video Processing Settings
MAX_VIDEO_SIZE_MB=500
CHUNK_DURATION_SECONDS=30
COMPRESS_RESOLUTION=720p
TEMP_STORAGE_PATH=./storage/temp

# Worker Settings
WORKER_POLL_INTERVAL_SECONDS=5
MAX_CONCURRENT_TASKS=3

# Scene Processing
SCENE_PROCESSING_MODE=sequential
MAX_GEMINI_WORKERS=10

# Avatar Live (Vertex Gemini Live preview). The preview surface is allowlisted
# per project — set AVATAR_LIVE_PROJECT to the allowlisted GCP project. Leave
# blank to disable the live WS.
AVATAR_LIVE_MODEL=gemini-3.1-flash-live-preview-04-2026
AVATAR_LIVE_PROJECT=
AVATAR_LIVE_LOCATION=global
AVATAR_LIVE_AUDIO_ONLY=false
# AVATAR_LIVE_HOST_OVERRIDE=  # set when the model graduates from sandbox
AVATAR_LIVE_DEBUG=false
